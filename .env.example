# Copie para .env e ajuste. O .env NAO vai para o Git.

# --- PostgreSQL ---
POSTGRES_DB=flightmon
POSTGRES_USER=flightmon
POSTGRES_PASSWORD=trocar-esta-senha
# 5433 porque a 5432 costuma estar ocupada por um PostgreSQL nativo
POSTGRES_PORT=5433

# --- Travelpayouts (camada 1 da coleta) --- etapa E1.5
TRAVELPAYOUTS_TOKEN=

# --- WhatsApp Cloud API --- etapa E1.12
# Ver docs/GUIA-WHATSAPP.md e docs/GUIA-NUMERO-BRASILEIRO.md
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# A conta (WABA) precisa ser a MESMA que contem o numero acima: template
# aprovado em outra conta simplesmente nao existe para este remetente (BUG-009)
WHATSAPP_WABA_ID=
# So preencher se o template tiver outro nome; o padrao ja e alerta_preco_voo
WHATSAPP_TEMPLATE_NAME=

# --- Webhook de status --- etapa E1.17, ver docs/GUIA-WEBHOOK.md
# Voce inventa este; a Meta o devolve na verificacao inicial da URL
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Painel: Configuracoes do app -> Basico -> Chave Secreta do App.
# VAZIO = o endpoint aceita qualquer POST, e ele e publico. So em desenvolvimento
WHATSAPP_APP_SECRET=

# --- Agente / linguagem natural --- etapa E3.1
# Opcional. Sem a chave, a interpretacao acontece so por regras — o sistema
# funciona, entendendo menos. O campo `provider` da resposta diz quem interpretou.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Mensageria --- etapa E4.1
# REST (padrao) ou AMQP. Os dois adaptadores implementam o mesmo contrato, com a
# mesma semantica sincrona: a troca e de transporte, nao de comportamento.
WORKER_TRANSPORTE=REST
RABBITMQ_USER=flightmon
RABBITMQ_PASSWORD=trocar-esta-senha
RABBITMQ_PORT=5672
RABBITMQ_UI_PORT=15672
# No worker: liga a segunda porta de entrada, ao lado do HTTP.
AMQP_ENABLED=false

# --- Canal de notificacao ---
# LOG (padrao, imprime no console) ou WHATSAPP (envia de verdade, cobrado)
NOTIFICATION_CHANNEL=LOG

# --- Canal de e-mail (E4.6) ---
# Conta do SISTEMA, nunca a pessoal. Ver docs/GUIA-EMAIL.md.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=sistema@exemplo.com
MAIL_PASSWORD=senha-de-app-de-16-caracteres
MAIL_FROM=sistema@exemplo.com
MAIL_FROM_NAME=Monitor de Passagens

# --- Producao (E4.4) --- ver docs/GUIA-DEPLOY.md
# O compose de producao RECUSA subir sem estas duas.
PAINEL_USUARIO=admin
PAINEL_SENHA=uma-senha-longa-de-verdade
CLOUDFLARE_TUNNEL_TOKEN=token-do-tunel-da-cloudflare
